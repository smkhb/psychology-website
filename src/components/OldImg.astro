---
import { Image } from "astro:assets";

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  layout?: "fixed" | "constrained" | "full-width";
  variant?: "primary" | "secondary";
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  class: className,
  variant = "primary",
  layout = "constrained",
  ...rest
} = Astro.props;

const baseStyles = "w-full h-auto object-cover";

const variantStyles = {
  primary: "hover:opacity-90 focus:opacity-90",
  secondary:
    "border-2 border-gray-300 hover:border-gray-500 focus:border-gray-500",
}[variant];
---

{
  (
    <Image
      src={src}
      alt={alt}
      width={width}
      height={height}
      layout={layout}
      class={`${baseStyles} ${variantStyles} ${className || ""}`}
      {...rest}
    />
  )
}
