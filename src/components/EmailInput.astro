---
import Button from "./Button.astro";
---

{
  (
    <div class="grid grid-cols-1 justify-center w-full md:w-auto">
      <div class="space-y-2 space-x-0 md:space-y-0 md:space-x-2">
        <label class="input rounded-lg validator  w-full md:w-xs">
          <svg
            class="h-[1em] opacity-50"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
          >
            <g
              stroke-linejoin="round"
              stroke-linecap="round"
              stroke-width="2.5"
              fill="none"
              stroke="currentColor"
            >
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </g>
          </svg>
          <input type="email" placeholder="Seu email" required />
        </label>
        <div class="validator-hint hidden">Insira um email válido.</div>
        <Button variant="primary" class="w-full md:w-auto">
          Inscrever-se
        </Button>
      </div>
    </div>
  )
}
