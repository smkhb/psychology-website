---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "tertiary";
  class?: string;
}

const { href, variant = "primary", class: className, ...rest } = Astro.props;

const baseStyles = "link font-montserrat font-medium text-base";

const variantStyles = {
  primary:
    "hover:bg-transparent hover:text-brand-brown focus:bg-transparent focus:text-brand-brown",
  secondary:
    "text-brand-green hover:text-brand-green-hover focus:bg-transparent",
  tertiary: "text-brand-green-clicked font-playfair text-h3 italic hover:text-brand-green-hover",
}[variant];
---

{
  (
    <a
      href={href}
      class={`${baseStyles} ${variantStyles} ${className || ""}`}
      {...rest}
    >
      <slot />
    </a>
  )
}
