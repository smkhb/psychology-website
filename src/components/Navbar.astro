---
import Button from "./Button.astro";
import Link from "./Link.astro";

---
{
  <div class="navbar bg-brand-gray shadow-sm lg:px-16 gap-6 sticky top-0 z-50">
    <div class="navbar lg:gap-2 w-3/4 lg:w-1/2">
      <div class="dropdown">
        <Button variant="transparent" class="lg:hidden"> 
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16"/></svg>
        </Button>
        <ul
          tabindex="-1"
          class="menu dropdown-content bg-brand-gray rounded-box z-1 mt-2 w-52 p-2 shadow">
          <li><Link href="/Serviços">Serviços</Link></li>
          <li><Link href="/Sobre">Sobre</Link></li>
          <li><Link href="/Blog">Blog</Link></li>
          <li><Link href="/Contato">Contato</Link></li>
          <li><Link href="/Políticas">Políticas</Link></li>
        </ul>
      </div>
      <h3><a href="#">Andreia Bernardo</a></h3>
    </div>
    <div class="navbar justify-end w-1/4 lg:w-1/2">
      <ul class="menu menu-horizontal hidden lg:flex">
        <li><Link href="/Serviços">Serviços</Link></li>
        <li><Link href="/Sobre">Sobre</Link></li>
        <li><Link href="/Blog">Blog</Link></li>
        <li><Link href="/Contato">Contato</Link></li>
        <li><Link href="/Políticas">Políticas</Link></li>
      </ul>
      <Button variant="secondary">Agendar</Button>
    </div>
  </div>
}
